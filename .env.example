# Environment Variables — copy to .env and fill in your values
# NEVER commit .env to git

# ─── WALLET ────────────────────────────────────────────────
# Your Solana wallet private key (Base58 encoded)
# USE A DEDICATED HOT WALLET — not your main wallet
PRIVATE_KEY=your_base58_private_key_here

# ─── CAPITAL ───────────────────────────────────────────────
STARTING_CAPITAL=20
MIN_TRADE_USDC=2
MAX_TRADE_USDC=10

# ─── RPC (optional, uses public endpoint if empty) ────────
# Get a free Helius key at https://helius.dev (1M credits/month free)
HELIUS_API_KEY=
# RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ─── FEATURE FLAGS ─────────────────────────────────────────
ENABLE_ML=false
ENABLE_JITO=false
ENABLE_WHALE_MONITOR=false
ENABLE_CROSS_DEX=true
ENABLE_ORDER_FLOW=true
ENABLE_REGIME=true

# ─── KELLY CRITERION ──────────────────────────────────────
# KELLY_WIN_RATE=0.55
# KELLY_WIN_LOSS_RATIO=2.0
# KELLY_FRACTION=0.5

# ─── RISK LIMITS ──────────────────────────────────────────
# MAX_POSITIONS=4
# MAX_DAILY_DRAWDOWN_PCT=8
# MAX_WEEKLY_DRAWDOWN_PCT=15

# ─── TIMING ───────────────────────────────────────────────
# POLL_INTERVAL_MS=3000

# ─── DATA ─────────────────────────────────────────────────
DATA_DIR=./data

# ─── COINBASE ADVANCED TRADE ──────────────────────────────
COINBASE_API_NAME="your_coinbase_api_key_name"
COINBASE_API_PRIVATE_KEY="your_coinbase_api_private_key"
COINBASE_PRODUCTS="BTC-USD,ETH-USD,SOL-USD"
COINBASE_SIMULATION=true
COINBASE_POLL_INTERVAL_MS=12000

# ─── SOCIAL SENTIMENT & TWITTER / X ────────────────────────
# Optional: Twitter / X API v2 Bearer Token (if omitted, falls back to live crypto news syndicate)
TWITTER_BEARER_TOKEN=""


# ─── QUANT RISK CONFIG (Alpha Overrides) ──────────────────
# Adjust these values to tune your trading edge
COINBASE_MIN_TRADE_USD=10.00
COINBASE_BULL_MAX_POS_PCT=0.25
COINBASE_BULL_MAX_POS=4
COINBASE_BULL_MIN_CASH=5.00
COINBASE_BULL_MIN_CONF=0.65
COINBASE_BEAR_MAX_POS_PCT=0.20
COINBASE_BEAR_MAX_POS=3
COINBASE_BEAR_MIN_CASH=10.00
COINBASE_BEAR_MIN_CONF=0.70

# Exits & Fees
COINBASE_STOP_LOSS_PCT=0.035
COINBASE_TAKE_PROFIT_PCT=0.055
COINBASE_TRAILING_TRIGGER_PCT=0.035
COINBASE_TRAILING_LOCK_PCT=0.018
COINBASE_MAKER_FEE_RATE=0.006
